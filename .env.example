# Copia este archivo como .env dentro de apps/api y apps/web según corresponda.
# --- API ---
PORT=4000
CORS_ORIGIN=http://localhost:5173
DATA_SOURCE=json            # json | postgres (futuro)
PERSIST_JSON=true           # guarda los cambios en apps/api/data/runtime
SHIFT_MOCK_DATES=true       # desplaza las fechas del seed para que "hoy" siempre tenga datos
DATABASE_URL=postgresql://user:password@localhost:5432/trackcontrol
# --- WEB ---
VITE_API_URL=/api
